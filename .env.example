# Generate distinct secrets, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Hex passwords avoid URI escaping when Compose builds the database URLs.
ASTRA_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_64_HEX_CHARACTERS
ASTRA_APP_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
DEMO_WEBHOOK_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
OWNER_EMAIL=owner@example.test
OWNER_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_16_CHARACTERS
PUBLIC_ORIGIN=https://demo.example.test
# Dedicated Compose network: keep the subnet/gateway paired; change both if they collide locally.
# The app trusts only this exact host-to-container reverse-proxy peer, never the whole subnet.
ASTRA_PROXY_SUBNET=172.29.250.0/24
ASTRA_PROXY_GATEWAY=172.29.250.1

# Citizen fee collection: disabled until an office completes merchant onboarding.
# This is separate from the local SaaS credit sandbox above. Never use personal
# wallet credentials. Enter issued merchant credentials only on the server.
BKASH_ENVIRONMENT=disabled
BKASH_TENANT_ID=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_MERCHANT_ACCOUNT=
# Independent random 32-byte (64 hex characters) key for durable gateway tokens.
BKASH_TOKEN_ENCRYPTION_KEY=
# Keep false until provider sandbox acceptance and explicit live activation.
BKASH_LIVE_ENABLED=false
# Separate 32-byte key for encrypted authenticator secrets. Generate your own;
# keep a protected recovery copy outside database backups. Never reuse a gateway key.
# Leave empty to disable NEW MFA enrollment until configured. Existing MFA must
# retain the original key; changing/removing it cannot bypass the second factor.
MFA_ENCRYPTION_KEY=
# Nagad has no adapter yet; merchant API documentation and onboarding are required.
