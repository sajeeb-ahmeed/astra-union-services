# Generate distinct secrets, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Hex passwords avoid URI escaping when Compose builds the database URLs.
ASTRA_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_64_HEX_CHARACTERS
ASTRA_APP_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
DEMO_WEBHOOK_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
# Sandbox subscription settlement self-signs with the secret above; leave unset (off) unless you want the demo button.
# DEMO_SETTLE_ENABLED=true
OWNER_EMAIL=owner@example.test
OWNER_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_16_CHARACTERS
PUBLIC_ORIGIN=https://demo.example.test
# Dedicated Compose network: keep the subnet/gateway paired; change both if they collide locally.
# The app trusts only this exact host-to-container reverse-proxy peer, never the whole subnet.
ASTRA_PROXY_SUBNET=172.29.250.0/24
ASTRA_PROXY_GATEWAY=172.29.250.1

# Citizen fee collection: disabled until an office completes merchant onboarding.
# This is separate from the local SaaS credit sandbox above. Never use personal
# wallet credentials. Enter issued merchant credentials only on the server.
BKASH_ENVIRONMENT=disabled
BKASH_TENANT_ID=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_MERCHANT_ACCOUNT=
# Independent random 32-byte (64 hex characters) key for durable gateway tokens.
BKASH_TOKEN_ENCRYPTION_KEY=
# Keep false until provider sandbox acceptance and explicit live activation.
BKASH_LIVE_ENABLED=false
# Separate 32-byte key for encrypted authenticator secrets. Generate your own;
# keep a protected recovery copy outside database backups. Never reuse a gateway key.
# Leave empty to disable NEW MFA enrollment until configured. Existing MFA must
# retain the original key; changing/removing it cannot bypass the second factor.
MFA_ENCRYPTION_KEY=
# Independent 32-byte (64 lowercase hex) outbound scanner service credential.
# Empty disables claim/finish only; uploaded documents still remain quarantined.
# Provision a different secret in the PC's private worker.json. Never use a user password.
ATTACHMENT_SCANNER_SECRET=
# Nagad has no adapter yet; merchant API documentation and onboarding are required.
# Phase 2b: keys the digest of mobile/NID/birth-registration sign-in numbers (32+ random characters).
# Never change it once accounts have added numbers: every stored number would stop matching.
# Without it in production, email sign-in still works and the other identifiers report "not enabled".
IDENTIFIER_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
# Phase 3a: encrypts NID and birth-registration numbers on citizen records (AES-256-GCM) so they can be printed.
# Exactly 64 hex characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Never change or lose it once numbers are stored: they could no longer be read. Keep a copy with the backups.
# Without it in production the server runs and entering these numbers reports "not enabled".
CITIZEN_DATA_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Phase 5c: encrypts each office's SSLCommerz store password (AES-256-GCM). Exactly 64 hex characters.
# Changing or losing it means every office must re-enter its store password. Keep a copy with the backups.
MERCHANT_SECRET_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Offices may save LIVE SSLCommerz credentials, but live collection stays off until this is "true".
# SSLCOMMERZ_LIVE_ENABLED=false
# Phase 7: online payment of subscription / credit orders. Orders are collected by the
# PLATFORM's own gateway, not the paying office's: set this to the tenant id of the
# platform's own office record, then configure that tenant's merchant exactly like any
# office (its office merchant rows win; for bKash the deployment BKASH_* config above
# applies when this tenant is also BKASH_TENANT_ID). Sandbox vs live is that merchant's
# configured environment — sandbox acceptance needs no real merchant account.
# Leave unset to keep order checkout disabled (orders then settle by owner action only).
# PLATFORM_GATEWAY_TENANT_ID=
# Phase 7: outbound email. "log" records messages in the server log (and, outside
# production, .runtime/email-outbox.log) without sending. "smtp" sends through your
# SMTP server via the settings below; without EMAIL_PROVIDER a production server
# reports email unavailable instead of pretending to send.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# Phase 2c: one-time codes for mobile verification. "log" writes codes to the server log only (no SMS).
# Leave unset in production until a real SMS provider is chosen; registration then works without a mobile.
# OTP_PROVIDER=log
# Phase 7: "http" sends OTP codes and status SMS through a Bangladeshi SMS gateway's
# HTTP API (the common api_key / senderid / number / message form shape; set
# SMS_HTTP_FORMAT=json for gateways that take a JSON body instead). Both values are
# required, otherwise the provider reports itself unavailable. SMS_HTTP_SENDER_ID is
# the gateway-issued sender id / masking name, when the gateway requires one.
# OTP_PROVIDER=http
# SMS_HTTP_URL=
# SMS_HTTP_API_KEY=
# SMS_HTTP_SENDER_ID=
# SMS_HTTP_FORMAT=form

# cPanel single-role deployments ONLY (see docs/DEPLOY-CPANEL.md): set to 1 when
# DATABASE_URL and DATABASE_ADMIN_URL name the same single cPanel database user
# and the db:*-cpanel scripts are used. Leave unset for the standard two-role setup.
# ASTRA_DB_SINGLE_ROLE=1
# Issuance mode: leave unset (or "demo") to keep DEMO wording on certificates
# and mode DEMO_ONLY in /api/v1/health. "official" drops the demo branding
# (health reports OFFICIAL) when the owner takes the platform live; the
# template's not-a-government-document honesty lines stay in both modes.
# ISSUANCE_MODE=official
