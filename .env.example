# Generate distinct secrets, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Hex passwords avoid URI escaping when Compose builds the database URLs.
ASTRA_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_64_HEX_CHARACTERS
ASTRA_APP_PASSWORD=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS
DEMO_WEBHOOK_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
OWNER_EMAIL=owner@example.test
OWNER_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_16_CHARACTERS
PUBLIC_ORIGIN=https://demo.example.test
# Dedicated Compose network: keep the subnet/gateway paired; change both if they collide locally.
# The app trusts only this exact host-to-container reverse-proxy peer, never the whole subnet.
ASTRA_PROXY_SUBNET=172.29.250.0/24
ASTRA_PROXY_GATEWAY=172.29.250.1
