{
  "name": "astra-union-services",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "prebuild": "node scripts/decode-assets.mjs",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts && node scripts/compress-assets.mjs && npm run build:seo",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "node scripts/decode-assets.mjs && tsx scripts/seed.ts",
    "test:forms": "node --import tsx --test packages/shared-schemas/test/*.test.ts",
    "test:api": "node --import tsx --test --test-concurrency=1 apps/api/test/*.test.ts",
    "test:openapi": "node scripts/update-batch-c-openapi.mjs --check && node --import tsx scripts/check-openapi-coverage.mjs",
    "openapi:generate": "node scripts/update-batch-c-openapi.mjs",
    "test:web": "tsx scripts/test-web.ts",
    "test:backup": "node --test scripts/backup/*.test.mjs",
    "db:backup": "node scripts/backup/backup.mjs backup",
    "db:recovery-drill": "node scripts/backup/recovery-drill.mjs",
    "test": "npm run test:backup && npm run test:scanner && npm run test:forms && npm run test:api && npm run test:support && npm run test:web",
    "start": "node --import tsx apps/api/src/server.ts",
    "db:bootstrap-role": "tsx scripts/bootstrap-db.ts",
    "db:initialize": "npm run db:bootstrap-role && npm run db:migrate && tsx scripts/initialize.ts",
    "test:scanner": "node --import tsx --test scripts/scanner/*.test.ts scripts/verify-hosted-attachments.test.ts",
    "scanner:check": "tsx scripts/scanner/real-engine.ts",
    "scanner:run": "tsx scripts/scanner/run.ts",
    "db:bootstrap-cpanel": "tsx scripts/bootstrap-cpanel.ts",
    "db:migrate-cpanel": "tsx scripts/migrate-cpanel.ts",
    "db:initialize-cpanel": "npm run db:bootstrap-cpanel && npm run db:migrate-cpanel && tsx scripts/initialize.ts",
    "build:seo": "node --import tsx apps/web/scripts/prerender-public.mjs",
    "build:api": "tsc -p packages/shared-schemas/tsconfig.build.json && tsc -p apps/api/tsconfig.build.json",
    "db:backup:offsite": "node scripts/backup/offsite-backup.mjs",
    "test:support": "node --import tsx --test scripts/test-support/*.test.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "express": "5.2.1",
    "nodemailer": "^10.6.0",
    "pg": "8.23.0",
    "playwright": "1.58.2",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.16.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "jsqr": "^1.4.0",
    "pngjs": "^5.0.0",
    "prettier": "^3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
