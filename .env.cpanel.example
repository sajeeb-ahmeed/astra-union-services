# DigitalUnion — cPanel single-role production environment template.
# Copy these variables into the cPanel "Setup Node.js App" environment
# (do NOT upload a filled copy of this file to a public place, and never
# commit real values). Full walkthrough: docs/DEPLOY-CPANEL.md.
#
# Generate every secret independently, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a protected copy of the generated values with your backups. Several
# keys can never be changed after first use (noted per key below).

# --- Single-role database (the cPanel track's defining setting) ----------
# cPanel provisions ONE PostgreSQL user per database. Both URLs name that
# same user; ASTRA_DB_SINGLE_ROLE=1 selects the db:*-cpanel scripts.
ASTRA_DB_SINGLE_ROLE=1
DATABASE_URL=postgres://CPANEL_DB_USER:URL_ENCODED_PASSWORD@127.0.0.1:5432/CPANEL_DB_NAME
DATABASE_ADMIN_URL=postgres://CPANEL_DB_USER:URL_ENCODED_PASSWORD@127.0.0.1:5432/CPANEL_DB_NAME
# Password for the one database user (used only if you ever re-run the
# canonical two-role bootstrap elsewhere; the cPanel scripts do not need it).
ASTRA_APP_PASSWORD=
# Not used by the cPanel scripts (kept for parity with .env.example).
ASTRA_ADMIN_PASSWORD=

# --- Server ----------------------------------------------------------------
NODE_ENV=production
# cPanel/Passenger assigns the port; set HOST to 127.0.0.1 unless the panel
# instructs otherwise. PORT is normally injected by Passenger — set it only
# if your panel shows a fixed application port.
HOST=127.0.0.1
# PORT=3001
# The exact public HTTPS origin of the site, no trailing slash. Browser
# sign-in is rejected (403) when the Origin does not match this value.
PUBLIC_ORIGIN=https://digitalunion.com.bd
# One Chromium at a time on shared hosting: keep PDFs serial.
PDF_MAX_CONCURRENCY=1
# If the hosting probe found a system Chromium, point the PDF renderer at
# it; otherwise leave unset and install the Playwright Chromium build into
# the app directory (see the runbook's PDF section).
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=/usr/bin/chromium

# --- Platform owner (created by db:initialize-cpanel on first deploy) -----
OWNER_EMAIL=owner@your-domain.example
OWNER_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_16_PLUS_CHARACTERS

# --- Application secrets (generate each one separately) --------------------
# Signs sandbox subscription settlement webhooks in demo flows.
DEMO_WEBHOOK_SECRET=
# Leave unset (off) unless you explicitly want the demo settlement button.
# DEMO_SETTLE_ENABLED=true
# Encrypts authenticator (MFA) secrets. Changing/removing it later breaks
# existing MFA enrollments; keep the original value forever.
MFA_ENCRYPTION_KEY=
# Credential for the attachment-scanner worker (the PC-side scanning
# service). Empty leaves uploaded documents quarantined.
ATTACHMENT_SCANNER_SECRET=
# Keys the digest of mobile/NID/birth-registration sign-in numbers (32+
# random characters; 64 hex recommended). NEVER change it once accounts
# have added numbers: every stored number would stop matching.
IDENTIFIER_SECRET=
# Encrypts NID and birth-registration numbers on citizen records
# (AES-256-GCM). EXACTLY 64 hex characters. Never change or lose it once
# numbers are stored: they could no longer be read.
CITIZEN_DATA_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Encrypts each office's merchant credentials (AES-256-GCM). EXACTLY 64
# hex characters. Changing or losing it means every office must re-enter
# its gateway credentials.
MERCHANT_SECRET_KEY=REPLACE_WITH_64_HEX_CHARACTERS

# --- Payments (sandbox by default; live is a business onboarding step) -----
BKASH_ENVIRONMENT=disabled
BKASH_TENANT_ID=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_MERCHANT_ACCOUNT=
# Independent random 32-byte (64 hex) key for durable gateway tokens.
BKASH_TOKEN_ENCRYPTION_KEY=
# Keep false until provider sandbox acceptance and explicit live activation.
BKASH_LIVE_ENABLED=false
# Offices may save LIVE SSLCommerz credentials, but live collection stays
# off until this is "true" and the office's store is approved.
# SSLCOMMERZ_LIVE_ENABLED=false

# --- SMS / one-time codes ----------------------------------------------------
# IMPORTANT: in production, mobile OTP is DISABLED ENTIRELY when OTP_PROVIDER
# is unset — the OTP endpoints answer 503 OTP_UNAVAILABLE and citizens cannot
# verify a mobile number at sign-up. Keep OTP_PROVIDER=log until a real SMS
# provider is chosen and integrated: "log" writes each code to the server log
# only (no SMS is sent to any handset), so sign-up verification works and the
# code can be read from the log while no provider exists.
OTP_PROVIDER=log

# --- Email (registration verification + status notifications) -----------------
# EMAIL_PROVIDER=log keeps email working on a deployment without any mail
# account: every message (the registration verification link, certificate
# issuance and application rejection notices) is written to the server log
# only — no email leaves the server, and verification links must be read from
# the log. For real delivery set EMAIL_PROVIDER=smtp and fill in the owner's
# SMTP settings below. IMPORTANT: in production, email is DISABLED ENTIRELY
# when EMAIL_PROVIDER is unset — /api/v1/auth/email/status then reports
# available:false, sign-up completes without a verification message, and no
# status email is sent (sign-in and the in-app notifications are unaffected).
EMAIL_PROVIDER=log
# SMTP_HOST=smtp.your-provider.example
# SMTP_PORT=587
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# --- Issuance mode -----------------------------------------------------------
# "demo" (default) keeps the DEMO wording on certificates and reports
# mode DEMO_ONLY in /api/v1/health. Set to "official" ONLY when the
# platform goes live for a real office (owner's decision; see the runbook).
# ISSUANCE_MODE=official
